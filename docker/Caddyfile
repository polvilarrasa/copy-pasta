{
	frankenphp
	order php_server before file_server
}

# SERVER_NAME is a domain (automatic HTTPS) or :8080 when TLS is terminated in front of the container.
{$SERVER_NAME::8080} {
	root * /app/public
	encode zstd gzip

	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	php_server
	header -Server
}
